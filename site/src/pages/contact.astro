---
// /contact/: every "Book a free consultation" button on the site lands here.
// The booking calendar comes first (live from GoHighLevel via /api/booking/*), then phone, email and visit.
// Office address, opening hours and reply time stay yellow (tbc) and out of schema until confirmed.
import TextPage from '../layouts/TextPage.astro';
import BookingCalendar from '../components/BookingCalendar.astro';
import { PHONE, EMAIL } from '../data/site.js';
import { CORE_UPDATED } from '../lib/catalog.js';

const faqs = [
  { q: 'Is the first consultation really free?', a: 'Yes. The first consultation is free and there is no obligation. We use it to understand what you need and give you a fixed price in writing.' },
  { q: 'Do I need to visit your office?', a: 'No. Most clients work with us by phone, video call and email, and documents are shared and signed online. Meetings in London are available by appointment.' },
  { q: 'Can you help if I live outside the UK?', a: 'Yes. We look after UK tax returns, UK property and UK companies for clients who live abroad, working online across time zones.' },
  { q: 'What should I have ready for the first call?', a: 'A short summary of what you need, any letters from HMRC or Companies House, and your last tax return or accounts if you have them. If you have none of these, call anyway.' },
];
---
<TextPage
  title="Book a Free Consultation | Contact Severin Finance"
  description="Book a free consultation with our London accountants online, or call 020 4542 2488. For clients across the UK and UK clients living abroad."
  url="/contact/"
  eyebrow="Contact"
  h1="Book a free consultation"
  answer="Pick a time below and your free consultation goes straight into our diary. Prefer to talk now? Call 020 4542 2488 or email enquiries@severinfinance.com. We are based in London and work with clients across the UK and abroad by phone, video call and email, with a fixed price in writing."
  pageType="ContactPage"
  faqs={faqs}
  faqTitle="Before you get in touch"
  reviewed={{ date: CORE_UPDATED, label: '13 October 2026' }}
>
  <section id="book" class="section" style="padding-top:0" aria-labelledby="book-title">
    <div class="container tp-body">
      <div>
        <h2 id="book-title" class="sr-only">Choose a time</h2>
        <BookingCalendar />
      </div>
      <aside class="tp-side" aria-label="What happens next">
        <div class="side-box">
          <h2>What happens next</h2>
          <ol style="display:grid;gap:8px;padding-left:1.2em">
            <li>We talk through what you need, free of charge.</li>
            <li>We send a fixed price and a timetable in writing.</li>
            <li>You approve, and your point of contact gets started.</li>
          </ol>
        </div>
        <div class="side-box">
          <h2>Looking for something?</h2>
          <ul>
            <li><a href="/uk/pricing/">Pricing</a></li>
            <li><a href="/resources/">Guides</a></li>
            <li><a href="/complaints/">Complaints</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
  <section class="section sp-tint" aria-labelledby="ways-title">
    <div class="container">
      <h2 id="ways-title" style="margin-bottom:24px">Other ways to contact us</h2>
      <div class="info-grid info-grid-3">
        <div class="info-card">
          <h3>Call</h3>
          <a class="big" href={`tel:${PHONE.tel}`}>{PHONE.display}</a>
          <p>Opening hours: <span class="tbc">Monday to Friday, 9am to 5.30pm (to confirm)</span></p>
        </div>
        <div class="info-card">
          <h3>Email</h3>
          <a class="big" style="font-size:1.25rem;word-break:break-all" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <p>We reply within <span class="tbc">1 working day (to confirm)</span>.</p>
        </div>
        <div class="info-card">
          <h3>Visit</h3>
          <p>London, by appointment. Office address: <span class="tbc">to confirm</span>.</p>
          <p>Working online with clients across the UK and abroad.</p>
        </div>
      </div>
    </div>
  </section>

</TextPage>
