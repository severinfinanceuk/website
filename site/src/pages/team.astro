---
// /team/: the people behind Severin Finance (E-E-A-T). People and facts live in src/data/team.js
// (from the current severinfinance.com team page); each gets a Person node below.
import TextPage from '../layouts/TextPage.astro';
import TeamCards from '../components/TeamCards.astro';
import { TEAM } from '../data/team.js';
import { orgRef, SITE } from '../data/site.js';
import { CORE_UPDATED } from '../lib/catalog.js';


const nodes = TEAM.map((t) => ({
  '@type': 'Person', '@id': `${SITE}/team/#${t.id}`, name: t.name, jobTitle: t.role, worksFor: orgRef,
  image: new URL(t.photo.src, SITE).href, description: t.bio, knowsLanguage: t.languages, knowsAbout: t.knowsAbout,
  ...(t.memberOf && { memberOf: t.memberOf }), ...(t.alumniOf && { alumniOf: t.alumniOf }),
}));

const faqs = [
  { q: 'Will I always speak to the same person?', a: 'Yes. You have one named point of contact for your work, backed by the rest of the team when you need a specialist.' },
  { q: 'Are your accountants qualified?', a: 'Yes. Managing Director Alain Dastros is a CIMA member in practice with an MBA from Cass Business School and over 30 years in accountancy. Hassaan Asad has over 4 years in accounting and is studying for the ACCA Strategic Professional qualification.' },
  { q: 'Who regulates Severin Finance?', a: 'Severin Finance Limited is regulated by the Chartered Institute of Management Accountants (CIMA), which is also our anti-money laundering supervisor.' },
  { q: 'Which languages do you speak?', a: 'English, French, Romanian, Urdu and Punjabi. That helps clients who are new to the UK, or who live abroad, go through their accounts and tax in the language they are most comfortable with.' },
  { q: 'Can I meet the team in person?', a: 'Yes, by appointment at our office at 107-111 Fleet Street, London EC4A 2AB. Most clients work with us by phone, video call and email, which suits clients across the UK and abroad.' },
];
---
<TextPage
  title="Our Team | Severin Finance Accountants, London"
  description="Meet the accountants and tax advisers at Severin Finance in London. One point of contact for your accounts and tax. Free consultation."
  url="/team/"
  breadcrumb={[['Home', '/'], ['About', '/about/'], ['Our team', '/team/']]}
  eyebrow="Our team"
  h1="The people behind your numbers"
  answer="Severin Finance is led by Managing Director Alain Dastros and a London team of accountants and tax advisers. Every client has one named point of contact who knows their affairs, with specialists in tax, company law and management accounts on hand. You speak to the person doing the work, not a call centre."
  faqs={faqs}
  faqTitle="Questions about our team"
  nodes={nodes}
  reviewed={{ date: CORE_UPDATED, label: '13 October 2026' }}
>
  <section class="band section" aria-labelledby="people-title">
    <div class="container">
      <div class="section-head split">
        <div>
          <span class="eyebrow">Leadership and team</span>
          <h2 id="people-title">Who you will work with</h2>
        </div>
        <p>Qualified accountants who answer the phone themselves.</p>
      </div>
      <TeamCards />
    </div>
  </section>

  <section class="section sp-tint" aria-labelledby="how-title">
    <div class="container tp-body">
      <div class="prose">
        <h2 id="how-title" style="margin-top:0">A team, not a single accountant</h2>
        <p>Small firms often rely on one person. We work as a team, so holidays and busy seasons never hold up your return. Your point of contact knows your affairs and brings in a colleague when the work needs it: a <a href="/uk/tax/">tax specialist</a> for a property sale, a <a href="/uk/company-services/">company secretarial</a> expert for a share issue, or our <a href="/uk/accounting/virtual-finance-director/">virtual finance director</a> when you need forecasts and management accounts.</p>
        <p>Every tax and accounting page on this site is reviewed by a qualified member of the team, and shows the date it was last checked against GOV.UK. The firm is regulated by the Chartered Institute of Management Accountants (CIMA).</p>
      </div>
      <aside class="tp-side" aria-label="More about us">
        <div class="side-box">
          <h2>More about us</h2>
          <ul>
            <li><a href="/about/">About Severin Finance</a></li>
            <li><a href="/reviews/">Client reviews</a></li>
            <li><a href="/locations/">Where we work</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</TextPage>
