---
// The team cards on the home page and /team/. People and facts come from src/data/team.js
// (taken from the current severinfinance.com team page). The last card books a free call.
import { Image } from 'astro:assets';
import { TEAM } from '../data/team.js';

const { highlight = false } = Astro.props;
---
<ul class:list={['cards cards-3', highlight && 'hl-group hl-3']} role="list">
  {TEAM.map((t, i) => (
    <li class:list={['person', highlight && 'hl-card']} style={`--i:${i}`}>
      <div class="person-media">
        <Image src={t.photo} alt={`${t.name}, ${t.role}`} widths={[360, 540, 720]} sizes="(min-width: 1000px) 400px, (min-width: 768px) 50vw, 100vw" quality={80} loading="lazy" decoding="async" style={`object-position:${t.focus}`} />
      </div>
      <div class="person-body">
        <span class="person-role">{t.role}</span>
        <h3 class="person-name">{t.name}</h3>
        <p class="person-bio">{t.bio}</p>
        <p class="person-meta">{t.languages.join(', ')}</p>
      </div>
    </li>
  ))}
  <li class:list={['person person-cta', highlight && 'hl-card']} style={`--i:${TEAM.length}`}>
    <div class="person-media" aria-hidden="true">+</div>
    <div class="person-body">
      <span class="person-role">Free consultation</span>
      <h3 class="person-name">Talk to us first</h3>
      <p class="person-bio">A free 30-minute call about your accounts or tax, with a fixed price in writing afterwards.</p>
      <a class="btn btn-fill" href="/contact/">Book a free consultation</a>
    </div>
  </li>
</ul>
