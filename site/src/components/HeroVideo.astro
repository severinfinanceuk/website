---
// "Welcome to Severin Finance" video in the home page hero (YouTube, privacy-enhanced domain).
// It starts playing on page load. Browsers only allow sound without a click once the visitor has
// used the site before, so it tries with sound first; if the browser blocks that, it plays muted
// and the sound comes on at the visitor's first click, tap or key press (or the "Turn sound on" button).
// Talks to the player with YouTube's postMessage protocol, so no YouTube script loads on our page.
// CSP: needs https://www.youtube-nocookie.com in frame-src (site/vercel.json).
import { VIDEO } from '../data/video.js';
---
<figure class="media hero-media hero-video" data-hero-video data-id={VIDEO.id}>
  <iframe
    title={VIDEO.title}
    allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
    data-player
  ></iframe>
  <button type="button" class="video-sound" data-sound hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 9l5 6m0-6l-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    Turn sound on
  </button>
  <noscript><a class="video-link" href={`https://www.youtube.com/watch?v=${VIDEO.id}`}>Watch the video on YouTube</a></noscript>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('[data-hero-video]');
  const frame = fig?.querySelector<HTMLIFrameElement>('[data-player]');
  const btn = fig?.querySelector<HTMLButtonElement>('[data-sound]');
  if (fig && frame && btn) {
    const ORIGIN = 'https://www.youtube-nocookie.com';
    const q = new URLSearchParams({
      autoplay: '1', mute: '0', playsinline: '1', rel: '0', modestbranding: '1', cc_load_policy: '0', iv_load_policy: '3',
      enablejsapi: '1', origin: location.origin, widget_referrer: location.href,
    });
    frame.src = `${ORIGIN}/embed/${fig.dataset.id}?${q}`;

    const cmd = (func: string, args: unknown[] = []) =>
      frame.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args, id: 1, channel: 'widget' }), ORIGIN);

    let ready = false, playing = false, muted = false, decided = false, state: number | undefined;

    // Sound on, from the start, once the browser allows it (needs a click, tap or key press on our page).
    const soundOn = () => {
      if (!muted) return;
      muted = false;
      cmd('unMute'); cmd('setVolume', [100]); cmd('seekTo', [0, true]); cmd('playVideo');
      btn.hidden = true;
      removeEventListener('pointerdown', soundOn, true);
      removeEventListener('keydown', soundOn, true);
    };
    const fallBackToMuted = () => {
      muted = true;
      cmd('mute'); cmd('playVideo');
      btn.hidden = false;
      addEventListener('pointerdown', soundOn, true);
      addEventListener('keydown', soundOn, true);
    };
    btn.addEventListener('click', soundOn);

    addEventListener('message', (e) => {
      if (e.origin !== ORIGIN || e.source !== frame.contentWindow || typeof e.data !== 'string') return;
      let d: { event?: string; info?: any };
      try { d = JSON.parse(e.data); } catch { return; }
      if (d.event === 'onReady' || d.event === 'initialDelivery') ready = true;
      const s = d.event === 'onStateChange' ? d.info : d.info?.playerState;
      if (typeof s === 'number') state = s;
      // Captions are burned into the video, so hide YouTube's own (it switches them on for muted play).
      if (s === 1 && !playing) cmd('unloadModule', ['captions']);
      if (s === 1) playing = true;
      if (ready && !decided) {
        decided = true;
        // Ask it to play with sound; if the browser blocks that, it stays unstarted, so play muted instead.
        // Still buffering (3) means it is starting with sound on a slow connection, so wait for it.
        cmd('unMute'); cmd('playVideo');
        const check = () => { if (playing) return; if (state === 3) setTimeout(check, 1000); else fallBackToMuted(); };
        setTimeout(check, 2500);
      }
      // The visitor used the player's own controls to turn the sound on.
      if (muted && d.info?.muted === false) { muted = false; btn.hidden = true; }
    });

    // Ask the player to send its events. It ignores this until it has loaded, so repeat until ready.
    const listen = () => frame.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: 1, channel: 'widget' }), ORIGIN);
    frame.addEventListener('load', () => {
      listen();
      const t = setInterval(() => (ready ? clearInterval(t) : listen()), 250);
      setTimeout(() => clearInterval(t), 10_000);
    });
  }
</script>
