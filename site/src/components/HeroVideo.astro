---
// "Welcome to Severin Finance" video in the home page hero (YouTube, privacy-enhanced domain).
// It starts playing on page load. Browsers only allow sound without a click once the visitor has
// used the site before, so it tries with sound first; if the browser blocks that, it plays muted
// and the sound comes on at the visitor's first click, tap or key press (or the "Turn sound on" button).
// Talks to the player with YouTube's postMessage protocol, so no YouTube script loads on our page.
// CSP: needs https://www.youtube-nocookie.com in frame-src (site/vercel.json).
import { VIDEO } from '../data/video.js';
---
<link rel="preconnect" href="https://www.youtube-nocookie.com" />
<figure class="media hero-media hero-video" data-hero-video data-id={VIDEO.id}>
  <iframe
    title={VIDEO.title}
    allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
    data-player
  ></iframe>
  <button type="button" class="video-sound" data-sound hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 9l5 6m0-6l-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    Turn sound on
  </button>
  <noscript><a class="video-link" href={`https://www.youtube.com/watch?v=${VIDEO.id}`}>Watch the video on YouTube</a></noscript>
</figure>

<!-- Inline, straight after the player, so the video starts loading while the rest of the page is still parsing -->
<script is:inline>
  (() => {
    const fig = document.querySelector('[data-hero-video]');
    const frame = fig && fig.querySelector('[data-player]');
    const btn = fig && fig.querySelector('[data-sound]');
    if (!frame || !btn) return;
    const ORIGIN = 'https://www.youtube-nocookie.com';
    const q = new URLSearchParams({
      autoplay: '1', mute: '0', playsinline: '1', rel: '0', modestbranding: '1', cc_load_policy: '0', iv_load_policy: '3',
      enablejsapi: '1', origin: location.origin, widget_referrer: location.href,
    });
    frame.src = `${ORIGIN}/embed/${fig.dataset.id}?${q}`;

    const cmd = (func, args = []) =>
      frame.contentWindow && frame.contentWindow.postMessage(JSON.stringify({ event: 'command', func, args, id: 1, channel: 'widget' }), ORIGIN);

    let ready = false, playing = false, muted = false, decided = false, seenMuted = false, state, timer;

    // Sound on, from the start, once the browser allows it (needs a click, tap or key press on our page).
    const soundOn = () => {
      if (!muted) return;
      muted = false;
      cmd('unMute'); cmd('setVolume', [100]); cmd('seekTo', [0, true]); cmd('playVideo');
      // The player brings its own captions back on unmute, sometimes a moment later.
      [300, 1000, 2000].forEach((ms) => setTimeout(() => cmd('unloadModule', ['captions']), ms));
      btn.hidden = true;
      removeEventListener('pointerdown', soundOn, true);
      removeEventListener('keydown', soundOn, true);
    };
    const fallBackToMuted = () => {
      if (decided) return;
      decided = true; muted = true;
      cmd('mute'); cmd('playVideo');
      btn.hidden = false;
      addEventListener('pointerdown', soundOn, true);
      addEventListener('keydown', soundOn, true);
    };
    btn.addEventListener('click', soundOn);

    addEventListener('message', (e) => {
      if (e.origin !== ORIGIN || e.source !== frame.contentWindow || typeof e.data !== 'string') return;
      let d;
      try { d = JSON.parse(e.data); } catch { return; }
      const info = d.info || {};
      if (d.event === 'onReady' || d.event === 'initialDelivery') ready = true;
      const s = d.event === 'onStateChange' ? d.info : info.playerState;
      // Captions are burned into the video, so hide YouTube's own each time it starts playing
      // (it switches them on for muted play, and again after the sound comes on).
      if (s === 1 && state !== 1) cmd('unloadModule', ['captions']);
      if (typeof s === 'number') state = s;
      if (info.muted === true) seenMuted = true;
      if (s === 1 && !playing) { playing = true; decided = true; }
      if (!ready || decided) {
        // The visitor turned the sound on with the player's own controls.
        if (muted && seenMuted && info.muted === false) { muted = false; btn.hidden = true; }
        return;
      }
      // With sound allowed, the player goes straight to buffering (3). If the browser blocks sound it
      // stays unstarted (-1), so switch to muted play almost at once rather than leave a still frame.
      clearTimeout(timer);
      if (state === -1) timer = setTimeout(() => { if (!playing && state === -1) fallBackToMuted(); }, 400);
      else timer = setTimeout(() => { if (!playing && state !== 3) fallBackToMuted(); }, 2000);
    });

    // Ask the player to send its events. It ignores this until it has loaded, so repeat until ready.
    const listen = () => frame.contentWindow && frame.contentWindow.postMessage(JSON.stringify({ event: 'listening', id: 1, channel: 'widget' }), ORIGIN);
    frame.addEventListener('load', () => {
      listen();
      const t = setInterval(() => (ready ? clearInterval(t) : listen()), 200);
      setTimeout(() => clearInterval(t), 10000);
    });
  })();
</script>
